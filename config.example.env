# AI4En 可选配置（先设置环境变量，再启动服务）
# 未配置时：生成接口使用内置示例模板，界面与日志标记为“示例内容”。

# 模型服务（OpenAI 兼容 /chat/completions）：用于教案、练习、反馈草稿
AI4EN_LLM_BASE_URL=https://api.example.com/v1
AI4EN_LLM_API_KEY=sk-your-key
AI4EN_LLM_MODEL=gpt-4o-mini

# 助教完整版（/static/lab/）的数字人、提示词教练、按课本生成教案
# 未配置时数字人走脚本对话，页面显示“演示模式”
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# 数据库位置（默认 app/data/ai4en.db）
# AI4EN_DB_PATH=./app/data/ai4en.db

# 服务端口（也可用 --port 参数）
# AI4EN_PORT=8848
